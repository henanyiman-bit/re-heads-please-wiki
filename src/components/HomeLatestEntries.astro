---
import WikiImage from "./WikiImage.astro";
import { getAccessories, getCoins, getEntryPath, getItems, type WikiCategory, type WikiEntry } from "../lib/data";

const byLatest = (entries: WikiEntry[]) => [...entries].sort((a, b) => b.updatedAt.localeCompare(a.updatedAt) || a.name.localeCompare(b.name)).slice(0, 2);
const latestEntries: { category: WikiCategory; entry: WikiEntry }[] = [
  ...byLatest(getItems()).map((entry) => ({ category: "items" as const, entry })),
  ...byLatest(getCoins()).map((entry) => ({ category: "coins" as const, entry })),
  ...byLatest(getAccessories()).map((entry) => ({ category: "accessories" as const, entry })),
];
const categoryLabel = (category: WikiCategory) => category.charAt(0).toUpperCase() + category.slice(1);
---

<section class="latest-entries" aria-labelledby="latest-entries-title">
  <header>
    <div><span>Verified database</span><h2 id="latest-entries-title">Latest Database Entries</h2></div>
    <a href="/database">Open full database <span aria-hidden="true">→</span></a>
  </header>
  <div class="latest-entries__grid">
    {latestEntries.map(({ category, entry }) => (
      <a class="latest-entry" href={getEntryPath(category, entry)}>
        <WikiImage src={entry.image} alt={`${entry.name} — RE:Heads, Please! ${category} entry`} width={1254} height={1254} loading="lazy" />
        <div>
          <small>{categoryLabel(category)}</small>
          <h3>{entry.name}</h3>
          <span>View entry <b aria-hidden="true">→</b></span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .latest-entries { margin: 0 0 4rem; }
  header { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  header div > span { color: var(--color-accent); font-size: .62rem; font-weight: 900; letter-spacing: .11em; text-transform: uppercase; }
  h2 { margin: .18rem 0 0; color: var(--color-ink); font-size: clamp(1.35rem, 2vw, 1.75rem); }
  header > a { color: var(--color-accent-dark); font-size: .72rem; font-weight: 850; text-decoration: none; }
  .latest-entries__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; }
  .latest-entry { display: grid; min-width: 0; overflow: hidden; border: 1px solid var(--color-border); border-radius: 13px; background: #fff; box-shadow: 0 7px 20px rgba(19,31,50,.06); color: var(--color-text); grid-template-columns: 104px minmax(0, 1fr); text-decoration: none; transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
  .latest-entry:hover { transform: translateY(-4px); border-color: rgba(195,50,37,.4); box-shadow: 0 15px 32px rgba(19,31,50,.11); color: var(--color-text); }
  .latest-entry :global(.wiki-image) { height: 100%; min-height: 104px; border: 0; border-right: 1px solid var(--color-border); border-radius: 0; }
  .latest-entry > div { display: flex; min-width: 0; flex-direction: column; justify-content: center; padding: .8rem; }
  small { color: var(--color-accent); font-size: .58rem; font-weight: 900; letter-spacing: .09em; text-transform: uppercase; }
  h3 { overflow: hidden; margin: .16rem 0 .55rem; color: var(--color-ink); font-size: .96rem; text-overflow: ellipsis; white-space: nowrap; }
  .latest-entry div > span { color: var(--color-muted); font-size: .68rem; font-weight: 800; }
  b { margin-left: .2rem; color: var(--color-accent); }
  @media (max-width: 960px) { .latest-entries__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .latest-entries { margin-bottom: 3rem; }
    header { align-items: flex-start; flex-direction: column; gap: .35rem; }
    .latest-entries__grid { grid-template-columns: 1fr; }
    .latest-entry { grid-template-columns: 92px minmax(0, 1fr); }
    .latest-entry :global(.wiki-image) { min-height: 92px; }
  }
  @media (prefers-reduced-motion: reduce) { .latest-entry { transition: none; } }
</style>
