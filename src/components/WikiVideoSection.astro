---
import YouTubeEmbed from "./YouTubeEmbed.astro";
import { getVideosForPage } from "../lib/videos";

interface Props {
  category: string;
  relatedSlug: string;
  variant?: "default" | "featured";
}

const { category, relatedSlug, variant = "default" } = Astro.props;
const videos = getVideosForPage(category, relatedSlug);
---

{videos.length > 0 && (
  <section class:list={["wiki-videos", { "wiki-videos--featured": variant === "featured" }]} aria-labelledby={`video-guide-${category}-${relatedSlug}`}>
    <header class="video-heading"><span class="play-mark" aria-hidden="true"></span><div><small>{variant === "featured" ? "Video guide" : "Watch and learn"}</small><h2 id={`video-guide-${category}-${relatedSlug}`}>{variant === "featured" ? "Watch & Learn" : "Video Guide"}</h2></div></header>
    {videos.map((video) => (
      <article class="video-card">
        <div class="video-preview"><YouTubeEmbed youtubeId={video.youtubeId} title={video.title} /></div>
        <div class="video-copy">
          {variant === "featured" && (
            <div class="video-benefits">
              <span>Guide Benefits</span>
              <ul><li>Gameplay</li><li>Progression</li><li>Mechanics</li></ul>
            </div>
          )}
          <h3>{video.title}</h3><p>{video.description}</p>
        </div>
      </article>
    ))}
  </section>
)}

<style>
  .wiki-videos { max-width: 820px; margin-top: 2.8rem; padding-top: .2rem; }
  .video-heading { display: flex; align-items: center; gap: .7rem; margin-bottom: 1rem; padding-bottom: .75rem; border-bottom: 1px solid var(--color-border); }
  .video-heading h2 { margin: 0; font-size: 1.45rem; }
  .video-heading small { display: block; margin-bottom: .06rem; color: var(--color-accent); font-size: .62rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
  .play-mark { position: relative; display: grid; width: 32px; height: 32px; flex: 0 0 auto; place-items: center; border-radius: 9px; background: var(--color-accent); box-shadow: 0 6px 14px rgba(195,50,37,.2); }
  .play-mark::after { margin-left: 2px; border-top: 5px solid transparent; border-bottom: 5px solid transparent; border-left: 8px solid #fff; content: ""; }
  .video-card { max-width: 820px; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface); box-shadow: var(--shadow-card); }
  .video-card + .video-card { margin-top: 2rem; }
  .video-copy { padding: 1rem 1.1rem 1.15rem; }
  .video-card h3 { margin: 0 0 .35rem; font-size: 1rem; }
  .video-card p { margin: 0; color: var(--color-muted); font-size: .88rem; }
  .video-card :global(.youtube-embed) { border: 0; border-bottom: 1px solid var(--color-border); border-radius: 0; box-shadow: none; }
  .wiki-videos--featured { max-width: none; margin: 0 0 4rem; padding: clamp(1rem, 2.5vw, 1.5rem); border: 1px solid var(--color-border); border-radius: 17px; background: linear-gradient(145deg, #fff, #f4f7fa); box-shadow: var(--shadow-card); }
  .wiki-videos--featured .video-heading { margin-bottom: 1rem; }
  .wiki-videos--featured .video-card { display: grid; max-width: none; align-items: center; grid-template-columns: minmax(0, 1.45fr) minmax(240px, .55fr); }
  .wiki-videos--featured .video-copy { padding: 1.3rem; }
  .wiki-videos--featured .video-copy h3 { font-size: 1.1rem; }
  .wiki-videos--featured .video-card :global(.youtube-embed) { border-right: 1px solid var(--color-border); border-bottom: 0; }
  .video-benefits { margin-bottom: 1rem; padding-bottom: .85rem; border-bottom: 1px solid var(--color-border); }
  .video-benefits > span { color: var(--color-accent); font-size: .6rem; font-weight: 900; letter-spacing: .11em; text-transform: uppercase; }
  .video-benefits ul { display: flex; flex-wrap: wrap; gap: .4rem; margin: .55rem 0 0; padding: 0; list-style: none; }
  .video-benefits li { padding: .34rem .52rem; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-soft); color: var(--color-text); font-size: .66rem; font-weight: 800; }
  @media (max-width: 720px) { .wiki-videos--featured .video-card { grid-template-columns: 1fr; } .wiki-videos--featured .video-card :global(.youtube-embed) { border-right: 0; border-bottom: 1px solid var(--color-border); } }
</style>
