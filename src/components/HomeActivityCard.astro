---
type ActivityIcon = "database" | "codes" | "guides";
interface Props {
  icon: ActivityIcon;
  badge: string;
  title: string;
  status: string;
  count: string;
  info: string;
  topics: string[];
  updatedAt: string;
  href: string;
  action: string;
}
const { icon, badge, title, status, count, info, topics, updatedAt, href, action } = Astro.props;
const formattedDate = new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }).format(new Date(`${updatedAt}T00:00:00Z`));
const iconPaths: Record<ActivityIcon, string> = {
  database: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
  codes: '<path d="M4 6.5h16v4a2.5 2.5 0 0 0 0 5v2H4v-2a2.5 2.5 0 0 0 0-5v-4Z"/><path d="M9 9.5v5M13 9.5v5"/>',
  guides: '<path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H12v18H7.5A3.5 3.5 0 0 0 4 23.5v-18ZM20 5.5A3.5 3.5 0 0 0 16.5 2H12v18h4.5a3.5 3.5 0 0 1 3.5 3.5v-18Z"/>',
};
---

<article class="activity-card" data-category={icon}>
  <div class="activity-card__top">
    <span class="activity-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[icon]}></svg></span>
    <span class="activity-card__badge">{badge}</span>
  </div>
  <div class="activity-card__title-row"><h3>{title}</h3><span class="activity-card__status"><i aria-hidden="true"></i>{status}</span></div>
  <p>{info}</p>
  <ul aria-label={`${title} topics`}>{topics.map((topic) => <li>{topic}</li>)}</ul>
  <div class="activity-card__meta"><strong>{count}</strong><span>Updated <time datetime={updatedAt}>{formattedDate}</time></span></div>
  <a href={href}>{action}<span aria-hidden="true">→</span></a>
</article>

<style>
  .activity-card { --activity-color: #2674c7; --activity-soft: #eef6ff; position: relative; display: flex; height: 274px; min-width: 0; flex-direction: column; padding: 1.15rem; overflow: hidden; border: 1px solid var(--color-border); border-top: 3px solid var(--activity-color); border-radius: 14px; background: linear-gradient(145deg, #fff 62%, var(--activity-soft)); box-shadow: 0 8px 22px rgba(19,31,50,.065); transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .activity-card::after { position: absolute; right: -28px; bottom: -34px; width: 106px; height: 106px; transform: rotate(9deg); border: 14px solid color-mix(in srgb, var(--activity-color) 8%, transparent); border-radius: 24px; content: ""; pointer-events: none; }
  .activity-card[data-category="codes"] { --activity-color: #c33225; --activity-soft: #fff0ec; }
  .activity-card[data-category="guides"] { --activity-color: #087d88; --activity-soft: #ecf9fa; }
  .activity-card:hover { transform: translateY(-6px); border-color: var(--activity-color); box-shadow: 0 20px 44px rgba(19,31,50,.15); }
  .activity-card__top, .activity-card__title-row, .activity-card__meta, a, p, ul { position: relative; z-index: 1; }
  .activity-card__top { display: flex; align-items: center; justify-content: space-between; gap: .7rem; }
  .activity-card__icon { display: grid; width: 40px; height: 40px; flex: 0 0 auto; place-items: center; border-radius: 10px; background: var(--activity-color); color: #fff; box-shadow: 0 7px 16px color-mix(in srgb, var(--activity-color) 25%, transparent); }
  svg { width: 22px; height: 22px; }
  .activity-card__badge { padding: .26rem .48rem; border-radius: 999px; background: color-mix(in srgb, var(--activity-color) 9%, #fff); color: var(--activity-color); font-size: .58rem; font-weight: 900; letter-spacing: .09em; text-transform: uppercase; white-space: nowrap; }
  .activity-card__title-row { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: .55rem; margin-top: .72rem; }
  h3 { display: -webkit-box; min-width: 0; margin: 0; overflow: hidden; color: var(--color-ink); font-size: 1.08rem; line-height: 1.25; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .activity-card__status { display: inline-flex; flex: 0 0 auto; align-items: center; gap: .3rem; color: #287d50; font-size: .57rem; font-weight: 850; white-space: nowrap; }
  .activity-card__status i { width: 7px; height: 7px; border-radius: 50%; background: #35b875; box-shadow: 0 0 0 3px rgba(53,184,117,.12); }
  p { display: -webkit-box; margin: .35rem 0 0; overflow: hidden; color: var(--color-muted); font-size: .74rem; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  ul { display: flex; flex-wrap: wrap; gap: .3rem; margin: .48rem 0 0; padding: 0; list-style: none; }
  li { padding: .16rem .36rem; border-radius: 5px; background: color-mix(in srgb, var(--activity-color) 9%, #fff); color: var(--activity-color); font-size: .57rem; font-weight: 800; white-space: nowrap; }
  .activity-card__meta { display: flex; align-items: center; justify-content: space-between; gap: .6rem; margin-top: .65rem; color: var(--color-muted); font-size: .61rem; }
  .activity-card__meta strong { color: var(--activity-color); font-size: .68rem; }
  .activity-card__meta span { white-space: nowrap; }
  a { display: flex; min-height: 38px; align-items: end; justify-content: space-between; gap: .6rem; margin-top: auto; padding-top: .62rem; border-top: 1px solid color-mix(in srgb, var(--activity-color) 14%, var(--color-border)); color: var(--activity-color); font-size: .72rem; font-weight: 850; text-decoration: none; }
  a span { transition: transform .18s ease; }
  a:hover span { transform: translateX(4px); }
  @media (prefers-reduced-motion: reduce) { .activity-card, a span { transition: none; } }
</style>
