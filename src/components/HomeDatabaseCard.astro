---
import { getOptimizedWikiImageSources } from "../lib/wikiImage";

interface Props {
  image: string;
  name: string;
  category: string;
  status: string;
  href: string;
}

const { image, name, category, status, href } = Astro.props;
const sources = getOptimizedWikiImageSources(image);
---

<a class="database-card" href={href} aria-label={`View ${name} in the ${category} database`}>
  <div class="database-card__image">
    <picture>
      {sources.avif && <source srcset={sources.avif} type="image/avif" />}
      {sources.webp && <source srcset={sources.webp} type="image/webp" />}
      <img src={sources.fallback} alt={`${name} — RE:Heads, Please! ${category} preview`} title={`${name} — RE:Heads, Please! ${category} preview`} width="1254" height="1254" loading="lazy" decoding="async" />
    </picture>
    <span>{status}</span>
  </div>
  <div class="database-card__copy">
    <small>{category}</small>
    <strong>{name}</strong>
    <span>View entry <b aria-hidden="true">→</b></span>
  </div>
</a>

<style>
  .database-card { display: grid; min-width: 0; overflow: hidden; border: 1px solid rgba(255,255,255,.12); border-radius: 14px; background: #18263c; color: #fff; grid-template-columns: 116px minmax(0, 1fr); text-decoration: none; transition: transform .18s ease, border-color .18s ease; }
  .database-card:hover { transform: translateY(-3px); border-color: rgba(255,101,77,.58); color: #fff; }
  .database-card__image { position: relative; aspect-ratio: 1; overflow: hidden; background: #101a2a; }
  picture, img { display: block; width: 100%; height: 100%; }
  img { object-fit: cover; }
  .database-card__image span { position: absolute; top: .55rem; left: .55rem; padding: .25rem .44rem; border: 1px solid rgba(255,255,255,.18); border-radius: 999px; background: rgba(16,26,42,.86); color: #8ee5b3; font-size: .6rem; font-weight: 850; letter-spacing: .04em; text-transform: uppercase; backdrop-filter: blur(6px); }
  .database-card__copy { display: flex; min-width: 0; flex-direction: column; justify-content: center; padding: .9rem 1rem; }
  small { color: #98a7bb; font-size: .64rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
  strong { overflow: hidden; margin: .15rem 0 .55rem; font-size: 1.05rem; text-overflow: ellipsis; white-space: nowrap; }
  .database-card__copy span { color: #ffc5bb; font-size: .72rem; font-weight: 800; }
  b { margin-left: .25rem; }
  @media (max-width: 760px) { .database-card { grid-template-columns: 104px minmax(0, 1fr); } }
</style>
