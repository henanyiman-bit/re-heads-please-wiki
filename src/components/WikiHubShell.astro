---
import WikiLayout from "../layouts/WikiLayout.astro";
import Badge from "./Badge.astro";

interface Stat { label: string; value: string | number; }
interface LinkItem { label: string; href: string; }
interface TocItem extends LinkItem {}
interface Props {
  title: string;
  description: string;
  label: string;
  h1: string;
  intro: string;
  updatedAt: string;
  status?: "Verified" | "Reference";
  stats: Stat[];
  actions: LinkItem[];
  onThisPage: TocItem[];
  popularPages: LinkItem[];
  allPages?: LinkItem[];
  relatedSections: LinkItem[];
  keywords?: string[];
}

const {
  title,
  description,
  label,
  h1,
  intro,
  updatedAt,
  status = "Reference",
  stats,
  actions,
  onThisPage,
  popularPages,
  allPages = [],
  relatedSections,
  keywords = [],
} = Astro.props;
const formattedDate = new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }).format(new Date(`${updatedAt}T00:00:00Z`));
---

<WikiLayout title={title} description={description} keywords={keywords}>
  <article class="page-shell hub-shell">
    <header class="hub-hero">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol><li><a href="/">Home</a></li><li aria-current="page">{label}</li></ol>
      </nav>
      <div class="hub-badges"><Badge label={label} tone="accent" /><span class="status-badge"><i aria-hidden="true"></i>{status}</span></div>
      <h1>{h1}</h1>
      <p class="page-intro">{intro}</p>
      <div class="hub-meta"><span>Last Updated</span><time datetime={updatedAt}>{formattedDate}</time></div>
      <dl class="quick-stats" aria-label={`${label} quick statistics`}>
        {stats.map((stat) => <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>)}
      </dl>
      <nav class="quick-actions" aria-label={`${label} quick actions`}>
        {actions.map((action, index) => <a class:list={{ primary: index === 0 }} href={action.href}>{action.label}<span aria-hidden="true">→</span></a>)}
      </nav>
    </header>

    <div class="hub-layout">
      <div class="hub-main">
        <slot />
        {allPages.length > 0 && (
          <section class="all-pages-directory" aria-labelledby="all-hub-pages">
            <div>
              <span>Continue exploring</span>
              <h2 id="all-hub-pages">All {label} Pages</h2>
              <p>Open a focused reference page for the topic you want to check next.</p>
            </div>
            <nav aria-label={`All ${label} pages`}>
              {allPages.map((item) => <a href={item.href}>{item.label}<span aria-hidden="true">→</span></a>)}
            </nav>
          </section>
        )}
      </div>
      <aside class="hub-sidebar" aria-label={`${label} navigation and status`}>
        <div class="sidebar-sticky">
          <details open>
            <summary>Hub Navigation <span aria-hidden="true">⌄</span></summary>
            <div class="sidebar-content">
              <section><h2>On This Page</h2><nav>{onThisPage.map((item) => <a href={item.href}>{item.label}</a>)}</nav></section>
              <section><h2>Popular Pages</h2><nav>{popularPages.map((item) => <a href={item.href}>{item.label}<span aria-hidden="true">↗</span></a>)}</nav></section>
              <section><h2>Related Sections</h2><nav>{relatedSections.map((item) => <a href={item.href}>{item.label}<span aria-hidden="true">→</span></a>)}</nav></section>
              <section class="wiki-status"><h2>Wiki Status</h2><p><i aria-hidden="true"></i>{status} page</p><small>Reviewed {formattedDate}</small></section>
            </div>
          </details>
        </div>
      </aside>
    </div>
  </article>
</WikiLayout>

<style>
  .page-shell.hub-shell { width: min(100% - 2rem, 1240px); padding: 0; overflow: visible; }
  .hub-shell::before { z-index: 2; }
  .hub-hero { position: relative; padding: clamp(1.4rem, 3.5vw, 2.5rem); overflow: hidden; border-radius: 18px 18px 0 0; background: radial-gradient(circle at 88% 18%, rgba(255,101,77,.13), transparent 25%), linear-gradient(135deg, #101a2a, #17263e); color: #fff; }
  .hub-hero::after { position: absolute; right: -38px; bottom: -64px; width: 190px; height: 150px; transform: rotate(12deg); border: 22px solid rgba(255,255,255,.035); border-radius: 36px; content: ""; }
  .breadcrumbs, .hub-badges, .hub-hero h1, .hub-hero > p, .hub-meta, .quick-stats, .quick-actions { position: relative; z-index: 1; }
  .breadcrumbs { margin-bottom: 1.15rem; color: #9eacc0; font-size: .78rem; }
  .breadcrumbs ol { display: flex; gap: .45rem; margin: 0; padding: 0; list-style: none; }
  .breadcrumbs li:not(:last-child)::after { margin-left: .45rem; color: #65748a; content: "/"; }
  .breadcrumbs a { color: #bdc8d8; text-decoration: none; }
  .hub-badges { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .status-badge { display: inline-flex; align-items: center; gap: .42rem; padding: .32rem .6rem; border: 1px solid rgba(255,255,255,.14); border-radius: 999px; background: rgba(255,255,255,.06); color: #d6dfeb; font-size: .65rem; font-weight: 850; letter-spacing: .05em; text-transform: uppercase; }
  .status-badge i, .wiki-status i { width: 8px; height: 8px; border-radius: 50%; background: #4dd889; box-shadow: 0 0 0 4px rgba(77,216,137,.12); }
  .hub-hero h1 { max-width: 850px; margin: .8rem 0 .65rem; color: #fff; font-size: clamp(2.2rem, 5vw, 3.45rem); }
  .hub-hero > p { max-width: 760px; margin: 0; color: #b8c4d5; }
  .hub-meta { display: flex; gap: .45rem; margin-top: .8rem; color: #8291a7; font-size: .7rem; font-weight: 750; }
  .hub-meta time { color: #dbe3ed; }
  .quick-stats { display: grid; max-width: 820px; margin: 1.35rem 0 0; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .65rem; }
  .quick-stats div { min-width: 0; padding: .78rem .88rem; border: 1px solid rgba(255,255,255,.11); border-radius: 10px; background: rgba(255,255,255,.055); backdrop-filter: blur(8px); }
  .quick-stats dt { overflow: hidden; color: #8e9db2; font-size: .62rem; font-weight: 850; letter-spacing: .07em; text-overflow: ellipsis; text-transform: uppercase; white-space: nowrap; }
  .quick-stats dd { overflow: hidden; margin: .16rem 0 0; color: #fff; font-size: 1rem; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
  .quick-actions { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1rem; }
  .quick-actions a { display: inline-flex; min-height: 40px; align-items: center; justify-content: space-between; gap: 1rem; padding: .58rem .78rem; border: 1px solid rgba(255,255,255,.16); border-radius: 8px; background: rgba(255,255,255,.07); color: #fff; font-size: .75rem; font-weight: 850; text-decoration: none; }
  .quick-actions a.primary { border-color: var(--color-accent-bright); background: var(--color-accent-bright); color: #161d29; }
  .quick-actions a:hover { border-color: #fff; color: #fff; }
  .quick-actions a.primary:hover { color: #161d29; }
  .hub-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 320px); grid-template-areas: "main side"; gap: clamp(1.5rem, 3vw, 2.4rem); padding: clamp(1.25rem, 3vw, 2.25rem); }
  .hub-main { min-width: 0; grid-area: main; }
  .hub-sidebar { min-width: 0; grid-area: side; }
  .sidebar-sticky { position: sticky; top: 8.3rem; }
  details { overflow: hidden; border: 1px solid var(--color-border); border-radius: 13px; background: #f8fafc; box-shadow: var(--shadow-card); }
  summary { display: none; padding: .85rem 1rem; background: var(--color-ink); color: #fff; cursor: pointer; font-size: .78rem; font-weight: 850; list-style: none; }
  summary span { float: right; }
  .sidebar-content { padding: 1rem; }
  .sidebar-content section + section { margin-top: 1.15rem; padding-top: 1.15rem; border-top: 1px solid var(--color-border); }
  .sidebar-content h2 { margin: 0 0 .55rem; color: var(--color-ink); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; }
  .sidebar-content nav { display: grid; gap: .25rem; }
  .sidebar-content nav a { display: flex; min-height: 34px; align-items: center; justify-content: space-between; gap: .5rem; padding: .35rem .45rem; border-radius: 7px; color: var(--color-muted); font-size: .78rem; font-weight: 700; text-decoration: none; }
  .sidebar-content nav a:hover { background: var(--color-accent-soft); color: var(--color-accent-dark); }
  .wiki-status p { display: flex; align-items: center; gap: .55rem; margin: 0; color: var(--color-text); font-size: .8rem; font-weight: 800; }
  .wiki-status small { display: block; margin: .3rem 0 0 1.05rem; color: var(--color-muted); font-size: .68rem; }
  :global(.hub-main > section:first-child), :global(.hub-main > .table-wrap:first-child) { margin-top: 0; }
  :global(.hub-data-panel) { margin-bottom: 2rem; padding: 1.2rem; border: 1px solid var(--color-border); border-radius: 14px; background: linear-gradient(145deg, #fff, #f6f8fb); box-shadow: var(--shadow-card); scroll-margin-top: 8rem; }
  :global(.hub-data-panel .panel-action) { display: inline-flex; margin-top: .85rem; color: var(--color-accent-dark); font-size: .78rem; font-weight: 850; text-decoration: none; }
  :global(.panel-actions), :global(.hub-link-strip) { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .85rem; }
  :global(.panel-actions a), :global(.hub-link-strip a) { display: inline-flex; min-height: 36px; align-items: center; padding: .4rem .62rem; border: 1px solid var(--color-border); border-radius: 7px; background: #fff; color: var(--color-accent-dark); font-size: .7rem; font-weight: 850; text-decoration: none; }
  :global(.panel-actions a:hover), :global(.hub-link-strip a:hover) { border-color: rgba(195,50,37,.35); background: var(--color-accent-soft); }
  :global(.hub-data-panel .table-wrap) { margin-top: 1rem; }
  :global(.topic-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; margin-top: 1rem; }
  .all-pages-directory { margin-top: 2rem; padding: 1.15rem; border: 1px solid var(--color-border); border-radius: 14px; background: linear-gradient(145deg, #fff, #f6f8fb); box-shadow: var(--shadow-card); }
  .all-pages-directory > div > span { color: var(--color-accent-dark); font-size: .68rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .all-pages-directory h2 { margin: .25rem 0 .35rem; font-size: 1.35rem; }
  .all-pages-directory p { margin: 0; color: var(--color-muted); font-size: .9rem; }
  .all-pages-directory nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .45rem; margin-top: 1rem; }
  .all-pages-directory a { display: flex; min-width: 0; min-height: 40px; align-items: center; justify-content: space-between; gap: .6rem; padding: .55rem .68rem; border: 1px solid var(--color-border); border-radius: 8px; background: #fff; color: var(--color-text); font-size: .78rem; font-weight: 750; text-decoration: none; }
  .all-pages-directory a:hover { border-color: rgba(195,50,37,.35); background: var(--color-accent-soft); color: var(--color-accent-dark); }
  @media (max-width: 1023px) {
    .hub-layout { grid-template-columns: 1fr; grid-template-areas: "main"; }
    .hub-sidebar { display: none; }
    .quick-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    :global(.topic-grid) { grid-template-columns: 1fr; }
    .all-pages-directory nav { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .page-shell.hub-shell { width: min(100% - 1rem, 1240px); }
    .hub-hero { border-radius: 14px 14px 0 0; }
    .hub-hero h1 { max-width: 12ch; font-size: clamp(2rem, 10vw, 2.65rem); }
    .quick-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .quick-actions a { flex: 1 1 calc(50% - .55rem); min-width: 0; }
    .hub-layout { padding: 1rem; gap: 1rem; }
    .sidebar-content { grid-template-columns: 1fr; }
    :global(.hub-data-panel) { padding: .8rem; }
    :global(.topic-grid) { grid-template-columns: 1fr; }
  }
</style>
