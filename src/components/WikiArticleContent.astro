---
import { render } from "astro:content";
import SchemaMarkup from "./SchemaMarkup.astro";
import WikiVideoSection from "./WikiVideoSection.astro";
import AdsenseSlot from "./ads/AdsenseSlot.astro";
import { getWikiArticleEntry, type WikiArticleEntry } from "../lib/wikiContent";

interface Props {
  category: string;
  slug: string;
  entry?: WikiArticleEntry;
  variant?: "default" | "hub";
}

const {
  category,
  slug,
  entry: providedEntry,
  variant = "default",
} = Astro.props;
const entry = providedEntry ?? await getWikiArticleEntry(category, slug);
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
---

{Content ? (
  <>
    <SchemaMarkup data={entry.data} />
    <div class:list={["wiki-content", { "wiki-content--hub": variant === "hub" }]} data-category={category} style={variant === "hub" ? `--hub-label: "${category.replace("-", " ")}"` : undefined}>
      <Content />
    </div>
  </>
) : (
  <slot />
)}
<AdsenseSlot position="content-middle" />
<WikiVideoSection category={category} relatedSlug={slug} />

<style>
  .wiki-content { max-width: 820px; margin-top: 2rem; color: #28364a; font-size: 1.01rem; }
  .wiki-content :global(p) { margin: .9rem 0; }
  .wiki-content :global(h2) { position: relative; margin-top: 3rem; padding: 0 0 .7rem 1rem; scroll-margin-top: 9rem; border-bottom: 1px solid var(--color-border); }
  .wiki-content :global(h2)::before { position: absolute; top: .05em; bottom: .7rem; left: 0; width: 4px; border-radius: 999px; background: var(--color-accent); content: ""; }
  .wiki-content :global(h3) { margin-top: 1.8rem; color: #223149; }
  .wiki-content :global(a) { font-weight: 650; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .wiki-content :global(table) { width: 100%; margin: 1.6rem 0; overflow: hidden; border: 1px solid var(--color-border); border-collapse: separate; border-spacing: 0; border-radius: var(--radius-card); background: var(--color-surface); box-shadow: var(--shadow-card); font-size: .9rem; }
  .wiki-content :global(th), .wiki-content :global(td) { padding: .8rem; border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); text-align: left; vertical-align: top; }
  .wiki-content :global(th:last-child), .wiki-content :global(td:last-child) { border-right: 0; }
  .wiki-content :global(tr:last-child td) { border-bottom: 0; }
  .wiki-content :global(th) { background: #152238; color: #eef3f9; font-size: .74rem; letter-spacing: .04em; text-transform: uppercase; }
  .wiki-content :global(tr:nth-child(even) td) { background: #fafbfd; }
  .wiki-content :global(blockquote) { margin: 1.6rem 0; padding: 1rem 1.25rem; border: 1px solid var(--color-border); border-left: 4px solid var(--color-accent); border-radius: 0 10px 10px 0; background: var(--color-soft); color: var(--color-muted); }
  .wiki-content :global(blockquote p) { margin: .25rem 0; }
  .wiki-content :global(ul), .wiki-content :global(ol) { padding-left: 1.35rem; }
  .wiki-content :global(li + li) { margin-top: .5rem; }
  .wiki-content :global(hr) { margin: 2.5rem 0; border: 0; border-top: 1px solid var(--color-border); }
  .wiki-content :global(h2#faq ~ h3) { position: relative; margin: .65rem 0 0; padding: .9rem 2.6rem .9rem 1rem; border: 1px solid var(--color-border); border-radius: 10px 10px 0 0; background: #f7f9fc; font-size: .94rem; }
  .wiki-content :global(h2#faq ~ h3::after) { position: absolute; top: 50%; right: 1rem; transform: translateY(-50%); color: var(--color-accent); content: "+"; font-size: 1.2rem; }
  .wiki-content :global(h2#faq ~ h3 + p) { margin: 0; padding: .85rem 1rem 1rem; border: 1px solid var(--color-border); border-top: 0; border-radius: 0 0 10px 10px; background: #fff; }
  .wiki-content--hub { max-width: none; margin-top: 2.5rem; }
  .wiki-content--hub :global(h2) { margin-top: 3.5rem; }
  .wiki-content--hub :global(h2#tldr + ul), .wiki-content--hub :global(h2#summary + ul) { display: grid; gap: .55rem; margin: 0; padding: 1rem 1.15rem 1rem 2.5rem; border: 1px solid rgba(195,50,37,.2); border-radius: 12px; background: linear-gradient(135deg, var(--color-accent-soft), #fff); box-shadow: var(--shadow-card); }
  .wiki-content--hub :global(h2#tldr + ul li::marker), .wiki-content--hub :global(h2#summary + ul li::marker) { color: var(--color-accent); }
  .wiki-content--hub :global(h2#overview), .wiki-content--hub :global(h2#main-content), .wiki-content--hub :global(h2[id^="how-to"]) { padding: .8rem 1rem; border: 1px solid var(--color-border); border-radius: 10px; background: #f7f9fc; }
  .wiki-content--hub :global(h2#overview::before), .wiki-content--hub :global(h2#main-content::before), .wiki-content--hub :global(h2[id^="how-to"]::before) { top: .8rem; bottom: .8rem; }
  .wiki-content--hub :global(h2#details-table + table), .wiki-content--hub :global(h2#data-preview + table) { position: relative; display: block; max-width: 100%; overflow-x: auto; border-top: 5px solid var(--color-ink); }
  .wiki-content--hub :global(h2#details-table + table th), .wiki-content--hub :global(h2#data-preview + table th) { position: sticky; top: 0; z-index: 1; }
  .wiki-content--hub :global(h2#priority-topics + ul) { display: grid; margin: 0; padding: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; list-style: none; }
  .wiki-content--hub :global(h2#priority-topics + ul li) { position: relative; display: flex; min-width: 0; min-height: 150px; flex-direction: column; margin: 0; padding: 2.15rem 1rem 1rem; border: 1px solid var(--color-border); border-radius: 11px; background: linear-gradient(145deg, #fff, #f7f9fc); box-shadow: var(--shadow-card); }
  .wiki-content--hub :global(h2#priority-topics + ul li::before) { position: absolute; top: .85rem; left: 1rem; padding: .18rem .42rem; border-radius: 999px; background: var(--color-accent-soft); color: var(--color-accent-dark); content: var(--hub-label); font-size: .57rem; font-weight: 850; letter-spacing: .07em; text-transform: uppercase; }
  .wiki-content--hub :global(h2#priority-topics + ul li a) { display: block; margin-bottom: .35rem; color: var(--color-ink); font-weight: 850; text-decoration: none; }
  .wiki-content--hub :global(h2#priority-topics + ul li a::after) { display: block; margin-top: auto; color: var(--color-accent-dark); content: "View guide →"; font-size: .7rem; }
  @media (max-width: 1023px) { .wiki-content--hub :global(h2#priority-topics + ul) { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    .wiki-content { overflow-wrap: anywhere; font-size: 1rem; }
    .wiki-content :global(h2) { margin-top: 2.4rem; scroll-margin-top: 1.5rem; }
    .wiki-content :global(table) { display: block; max-width: 100%; overflow-x: auto; border-radius: 10px; }
  }
</style>
