---
interface Props { title: string; description?: string; eyebrow?: string; href?: string; linkLabel?: string; id?: string; }
const { title, description, eyebrow, href, linkLabel = "View all", id } = Astro.props;
---
<header class="section-header">
  <div>
    {eyebrow && <p>{eyebrow}</p>}
    <h2 id={id}>{title}</h2>
    {description && <span>{description}</span>}
  </div>
  {href && <a href={href}>{linkLabel}<span aria-hidden="true">→</span></a>}
</header>
<style>
  .section-header { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin: 2.8rem 0 1.1rem; padding-bottom: .85rem; border-bottom: 1px solid var(--color-border); }
  p { margin: 0 0 .28rem; color: var(--color-accent); font-size: .7rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
  h2 { margin: 0; font-size: clamp(1.45rem, 3vw, 1.9rem); }
  div > span { display: block; max-width: 650px; margin-top: .4rem; color: var(--color-muted); font-size: .94rem; }
  a { display: inline-flex; flex: 0 0 auto; align-items: center; gap: .4rem; color: var(--color-accent); font-size: .86rem; font-weight: 750; text-decoration: none; }
  a span { transition: transform .18s ease; } a:hover span { transform: translateX(3px); }
  @media (max-width: 620px) { .section-header { align-items: flex-start; flex-direction: column; } }
</style>
