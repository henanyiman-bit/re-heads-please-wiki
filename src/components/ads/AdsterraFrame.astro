---
interface Props { kind: 'leaderboard' | 'rectangle' | 'mobile' | 'native' }
const { kind } = Astro.props;
const sizes = { leaderboard: [728, 90], rectangle: [300, 250], mobile: [320, 50], native: [640, 320] };
const [width, height] = sizes[kind];
---
<aside class:list={['ad-slot', `ad-slot--${kind}`]} data-adsterra={kind} aria-label="Advertisement" style={`--ad-width:${width}px;--ad-height:${height}px`}>
  <span class="ad-label">Advertisement</span>
  <div class="ad-mount"></div>
</aside>
<script>
  import { initializeAds } from '../../lib/adsterra';
  initializeAds();
  document.addEventListener('astro:page-load', initializeAds);
</script>
<style>
  .ad-slot { display: none; box-sizing: border-box; width: 100%; min-width: 0; margin: 2.5rem auto; padding: 1rem 0; border-top: 1px solid #e3e7ee; border-bottom: 1px solid #e3e7ee; text-align: center; overflow: hidden; }
  .ad-label { display: block; height: 22px; font: 11px/22px system-ui, sans-serif; color: #697586; }
  .ad-mount { width: min(100%, var(--ad-width)); height: var(--ad-height); min-height: var(--ad-height); margin: 0 auto; overflow: hidden; }
  .ad-slot[data-ad-selected] { display: block; }
</style>
